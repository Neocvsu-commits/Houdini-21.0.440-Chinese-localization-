{
  "enable": "houdini_version == '22.0'",
  "load_package_once": true,
  "hpath": "$HOUDINI_PACKAGE_PATH/HoudiniChinese",
  "preload_libraries": [
    "$HOUDINI_PACKAGE_PATH/HoudiniChinese/HoudiniChineseHook.dll"
  ],
  "env": [
    {
      "HOUDINI_CHINESE_EXPERIMENT_QT_INLINE": "1"
    },
    {
      "HOUDINI_CHINESE_EXPERIMENT_LATE_LOOK": "1"
    }
  ]
}
